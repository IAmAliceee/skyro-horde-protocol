root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
dotnet_diagnostic.RCS1169.severity = silent
dotnet_diagnostic.IDE0130.severity = silent

[*.{json,asmdef,md,yml,yaml}]
indent_style = space
indent_size = 2
